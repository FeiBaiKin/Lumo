# Lumo 部署环境变量样板。
#
#   cp .env.example .env
#
# .env 里有真实口令，**不要提交**（仓库 .gitignore 已列 deploy/.env）。
# docker compose 会自动读取与 docker-compose.yml 同目录的 .env。

# ---------- 必填 ----------

# PostgreSQL 口令。没有默认值，不填 compose 会直接报错退出。
#
# 它会被拼进 DSN 的 URL 里，所以**请只用字母、数字与 - _ . ~ 这几类字符**。
# 含 @ : / ? # % 等字符时必须先做百分号编码，否则连接串会被解析错位，
# 表现是「口令明明对却连不上」。生成一个安全又 URL 安全的：
#
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
#
POSTGRES_PASSWORD=

# ---------- 数据库（改了要连带改 DSN，通常保持默认即可）----------

POSTGRES_DB=lumo
POSTGRES_USER=lumo

# ---------- 站点 ----------

# 对外可访问地址，带协议、不带末尾斜杠，例如 https://example.com
# 留空时 sitemap.xml 与订阅源会明确返回 503，而不是产出一堆相对地址。
LUMO_EXTERNAL_URL=

# 端口映射的绑定地址。默认只绑回环，由前面的反向代理终结 TLS 后转发过来。
# 要临时直接对外（明文 HTTP，仅限内网或调试）：0.0.0.0:8080
LUMO_BIND=127.0.0.1:8080

# 上了 HTTPS 后改成 true：启用 Cookie 的 Secure 属性与 __Host- 前缀。
# 纯 HTTP 下必须保持 false，否则浏览器不保存会话 Cookie，登录会「成功后立刻失效」。
LUMO_SECURE_COOKIES=false

# 可信反向代理的 CIDR，逗号分隔，例如 172.16.0.0/12
# 留空 = 不信任任何代理，一律使用直连地址（最安全的默认值）。
# 不填的后果：评论限流与日志里看到的都是反代的 IP，而不是访客的。
LUMO_TRUSTED_PROXIES=

# ---------- 日志 ----------

# debug / info / warn / error
LUMO_LOG_LEVEL=info
# text / json；容器里默认 json，便于采集
LUMO_LOG_FORMAT=json

# ---------- 可选：邮件与对象存储 ----------
#
# 这两类凭据刻意不进设置表——设置会随备份、日志与接口响应流出。
# 其余 SMTP 项（主机、端口、发件人）在后台「设置 → 邮件」里配。

LUMO_SMTP_PASSWORD=
LUMO_S3_ACCESS_KEY=
LUMO_S3_SECRET_KEY=
