# Lumo 部署环境变量样板。
#
#   cp .env.example .env
#
# .env 里有真实口令，**不要提交**（仓库 .gitignore 已列 deploy/.env）。
# docker compose 会自动读取与 docker-compose.yml 同目录的 .env。

# ---------- 必填 ----------

# PostgreSQL 原始口令：原样交给 PostgreSQL 初始化，**不要**做百分号编码。
# 没有默认值，不填 compose 会直接报错退出。
# 生成一个随机口令（字母数字最省事）：
#
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
#
POSTGRES_PASSWORD=

# 应用连接串（完整 URL）。可以不填：compose 会用上面的 POSTGRES_* 组件拼一条，
# 这就是快速开始路径，仅适用于字母、数字与 - _ . ~ 这类 URL 安全口令。
#
# 口令含 @ : / ? # % 等特殊字符时必须单独填这里，且只对 **DSN 里的口令段**
# 做百分号编码；POSTGRES_PASSWORD 保持原始口令不变。若把编码后的串填进
# POSTGRES_PASSWORD，PostgreSQL 会把编码串当真实口令保存，而客户端解析 DSN
# 后用解码值去连，首次部署必然失败。
#
# 例：原始口令 p@ss:w/rd（POSTGRES_PASSWORD 原样填它），DSN 里的口令段编码为
# p%40ss%3Aw%2Frd：
#
#   POSTGRES_PASSWORD=p@ss:w/rd
#   LUMO_DATABASE_DSN="postgres://lumo:p%40ss%3Aw%2Frd@postgres:5432/lumo?sslmode=disable"
#
# 编码后的 DSN 不含裸 # 与 $，无需担心 .env 的注释与变量展开；仍建议整条加引号。
#
# 两种场景：
#   * 首次初始化（pgdata 卷为空）：postgres 容器用 POSTGRES_PASSWORD 建库建角色，
#     应用用 LUMO_DATABASE_DSN 连接。两者描述同一个原始口令，只是一个未编码、
#     一个已编码，必须同时填写并保持一致。
#   * 已有数据卷：初始化脚本不会重跑，改 POSTGRES_PASSWORD 不会改数据库里的口令，
#     应用会突然连不上。保持口令不变即可；确要更换时先改库，再同步改两个变量：
#
#       docker compose exec postgres psql -U lumo -d lumo \
#         -c "ALTER USER lumo WITH PASSWORD '新的原始口令';"
#
LUMO_DATABASE_DSN=

# ---------- 数据库（改了要连带改 DSN，通常保持默认即可）----------

POSTGRES_DB=lumo
POSTGRES_USER=lumo

# ---------- 站点 ----------

# 对外可访问地址，带协议、不带末尾斜杠，例如 https://example.com
# 留空时 sitemap.xml 与订阅源会明确返回 503，而不是产出一堆相对地址。
LUMO_EXTERNAL_URL=

# 端口映射的绑定地址。默认只绑回环，由前面的反向代理终结 TLS 后转发过来。
# 要临时直接对外（明文 HTTP，仅限内网或调试）：0.0.0.0:8080
LUMO_BIND=127.0.0.1:8080

# 上了 HTTPS 后改成 true：启用 Cookie 的 Secure 属性与 __Host- 前缀。
# 纯 HTTP 下必须保持 false，否则浏览器不保存会话 Cookie，登录会「成功后立刻失效」。
LUMO_SECURE_COOKIES=false

# 可信反向代理的 CIDR，逗号分隔，例如 172.16.0.0/12
# 留空 = 不信任任何代理，一律使用直连地址（最安全的默认值）。
# 不填的后果：评论限流与日志里看到的都是反代的 IP，而不是访客的。
LUMO_TRUSTED_PROXIES=

# ---------- 日志 ----------

# debug / info / warn / error
LUMO_LOG_LEVEL=info
# text / json；容器里默认 json，便于采集
LUMO_LOG_FORMAT=json

# ---------- 可选：邮件与对象存储 ----------
#
# 这两类凭据刻意不进设置表——设置会随备份、日志与接口响应流出。
# 其余 SMTP 项（主机、端口、发件人）在后台「设置 → 邮件」里配。

LUMO_SMTP_PASSWORD=
LUMO_S3_ACCESS_KEY=
LUMO_S3_SECRET_KEY=
