# 构建产物
/lumo
/lumo.exe
/dist/
internal/console/dist/*
# 占位文件必须入库：go:embed all:dist 要求目录存在，否则全新克隆无法编译
!internal/console/dist/.gitkeep

# 运行时数据（工作目录）
/data/
# 主密钥：正常只会在 data/ 下，但测试偶尔会把它落到别处，落了也不能入库
secret.key

# 内部工作文档（仅本地，不入库）
/agent.md
/STATUS.md

# AI 工具会话残留（仅本地，不入库）
/.dsh-sess/
/.dsh_*

# 本地启动脚本（仅本地，不入库）
/dev.cmd

# 官网 lumo.xzji.top 的主题（不开源，仅本地）
/website/

# 依赖
node_modules/

# go test -c 的二进制与剖析输出
*.test
*.out

# 配置与环境（含密钥，不入库）
.env
.env.*
!.env.example
config.local.yaml
# 本地实际配置不入库，只保留 config.example.yaml
/config.yaml
/config.yml

# 日志
# 只忽略运行时产生的那些：不带前缀的 logs/ 会连 internal/logs（日志模块的源码）
# 一起挡掉，而那是要入库的。
*.log
/data/logs/

# 编辑器与系统
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak

# 部署环境变量（含真实口令）
/deploy/.env
