# 构建产物
/lumo
/lumo.exe
/dist/
internal/console/dist/*
# 占位文件必须入库：go:embed all:dist 要求目录存在，否则全新克隆无法编译
!internal/console/dist/.gitkeep

# 运行时数据（工作目录）
/data/

# 内部工作文档（仅本地，不入库）
/agent.md
/STATUS.md

# AI 工具会话残留（仅本地，不入库）
/.dsh-sess/
/.dsh_*

# 依赖
node_modules/

# 测试与覆盖率
*.test
*.out
coverage/
coverage.out

# 配置与环境（含密钥，不入库）
.env
.env.*
!.env.example
config.local.yaml
# 本地实际配置不入库，只保留 config.example.yaml
/config.yaml
/config.yml

# 日志
*.log
logs/

# 编辑器与系统
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak
